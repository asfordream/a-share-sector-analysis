# A 股板块深度分析系统 — 环境变量模板
#
# 用法：
#   cp .env.example .env
#   编辑 .env 填入自己的值
#   set -a && source .env && set +a
#
# 说明：代码内不含任何真实凭据，所有敏感值均从此处注入。
#       未配置的变量取空字符串，相关推送功能会静默跳过，不影响分析流程。

# ── 飞书自定义机器人 webhook（群消息推送）────────────
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
FEISHU_WEBHOOK=

# ── 飞书用户 open_id（bot 私信目标）──────────────────
FEISHU_USER_OPEN_ID=

# ── 飞书群 chat_id ──────────────────────────────────
FEISHU_GROUP_CHAT_ID=
FEISHU_CHAT_ID=

# ── 飞书 bot 云盘目录 token（HTML 上传目标）──────────
FEISHU_FOLDER_TOKEN=

# ── 历史消息 ID（仅补推/纠错类脚本使用，可留空）──────
FEISHU_MSG_CPO_FILE=
FEISHU_MSG_CPO_POST=
FEISHU_MSG_AGG_CARD=
FEISHU_MSG_CUR_CARD=
FEISHU_MSG_OLD_AGG=
FEISHU_MSG_BROKEN_AGG=

# ── lark-cli 可执行文件路径（默认从 PATH 查找）───────
LARK_CLI=lark-cli

# ── 其他运行时二进制（默认从 PATH 查找）─────────────
NODE_BIN=node
PYTHON_BIN=python3

# ── 港股板块目录（仅 preview_tech4.py 跨市场预览用）─
HK_SECTOR_DIR=
